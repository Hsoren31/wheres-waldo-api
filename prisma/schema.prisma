generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Stage {
  id          String      @id @default(uuid())
  title       String      @unique
  image       Image?
  characters  Character[]
  leaderBoard Game[]
}

model Image {
  url     String @id
  height  Int
  width   Int
  stageId String @unique
  stage   Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
}

model Character {
  id       String  @id @default(uuid())
  name     String
  location Json
  stageId  String?
  stage    Stage?  @relation(fields: [stageId], references: [id], onDelete: Cascade)
}

model Game {
  id         String   @id @default(uuid())
  playerName String?
  time       Float?
  createdAt  DateTime @default(now())
  characters Json
  stageId    String?
  stage      Stage?   @relation(fields: [stageId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}
