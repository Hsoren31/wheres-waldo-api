generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Stage {
  id          String      @id @default(uuid())
  title       String      @unique
  characters  Character[]
  image       Image?
  leaderBoard Score[]
}

model Image {
  title   String @id @unique
  url     String
  height  Int
  width   Int
  stageId String @unique
  stage   Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
}

model Character {
  id       String  @id @default(uuid())
  name     String
  location Json
  stageId  String?
  stage    Stage?  @relation(fields: [stageId], references: [id], onDelete: Cascade)
}

model Score {
  id        String   @id @default(uuid())
  name      String
  time      Float
  createdAt DateTime @default(now())
  stageId   String?
  stage     Stage?   @relation(fields: [stageId], references: [id], onDelete: Cascade)
}
